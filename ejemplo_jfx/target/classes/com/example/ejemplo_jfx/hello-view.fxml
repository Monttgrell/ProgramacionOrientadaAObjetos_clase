<VBox fx:id="txtnombre" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejemplo_jfx.HelloController">
   <children>
      <Label id="lbl_sal_2" fx:id="lbl_sal_2" alignment="CENTER" prefHeight="17.0" prefWidth="144.0" text="..." textAlignment="CENTER" >
         <font>
            <Font name="Comic Sans MS" size="38.0" />
         </font></Label>
      <Button fx:id="btn_sal" alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="44.0" prefWidth="98.0"  onAction="#Saludar" text="Saludar" />
