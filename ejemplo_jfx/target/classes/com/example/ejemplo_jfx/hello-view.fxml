      <TextField id="txt_ing_nombre" fx:id="txt_ing_nombre" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="22.0" prefWidth="143.0" promptText="cabeza de alcornoque" />
